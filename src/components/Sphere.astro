---
const { imageSrc, size, tooltip='' } = Astro.props;
---

<style>

  .sphere-container {
    position: relative;
    display: inline-block;
    transition: transform 0.3s ease-in-out;
  }

  .sphere-container:hover {
    transform: scale(1.3); /* Aumenta o tamanho em 10% no hover */
  }

  .sphere {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: #ccc;
    background-size: cover;
    transform-style: preserve-3d;
    transition: transform 0.3s ease-in-out;
  }

  .tooltip {
    text-align: center;
    opacity: 0; 
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%); /* Centraliza na esfera */
    background-color: rgba(0, 0, 0, 0.8);
    color: white;
    padding: 8px 12px;
    border-radius: 4px;
    font-size: 14px;
    transition: opacity 0.3s ease-in-out; 
  }

  .sphere:hover .tooltip {
    opacity: 1; /* Torna visível ao passar o mouse */
  }
</style>

<div class="sphere-container">
  <div style=`width: ${size}; height: ${size};`>
    <div class="sphere" style={`background-image: url('${imageSrc}');`}>
        <div class="tooltip">
            {tooltip}
        </div>  
    </div>
</div>
</div>